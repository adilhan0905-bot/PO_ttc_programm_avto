@startuml
left to right direction
skinparam componentStyle rectangle

component "CWS Application" as app {
  [Tkinter UI] as ui
  [Video Stream] as video
  [Object Detector\nYOLO / PyTorch] as detector
  [TTC Calculator] as ttc
  [Warning Manager] as warning
  [CSV Logger] as logger
  [Recorder] as rec
  [Camera Calibration\nOpenCV] as calib
  [CAN Adapter] as can
  [Settings] as settings
}

ui --> video : open video/camera
ui --> settings : read/write
video --> detector : frames
detector --> ttc : detections
ttc --> warning : TTC + level
warning --> ui : visual alert
warning --> logger : warning event
warning --> can : TTC < 1s
video --> rec : annotated frames
ui --> calib : calibration images
calib --> settings : calibration.json

@enduml
